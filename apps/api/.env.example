# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger

# Redis — caching and the scan write-lock.
REDIS_URL=redis://localhost:6380

# Auth — the single bearer token every client must send. Generate a long random one:
#   openssl rand -hex 32
API_TOKEN=

# SEFAZ-BA NFC-e consultation host (used by @ledger/nfce). Override only if it changes.
SEFAZ_BASE_URL=http://nfe.sefaz.ba.gov.br/servicos/nfce/modulos/geral/

# Firebase Cloud Messaging — push notifications to the iOS app. Optional: leave unset to disable push.
# Service account JSON, base64-encoded:  base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# OpenTelemetry logs — optional. Leave unset to log only to stdout. Point at an OTLP-compatible
# backend; the SDK appends /v1/logs automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Auth headers for the OTLP endpoint, comma-separated key=value pairs.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ledger-api

# AI — photo scan (POST /scan/photo), typed lançamentos (POST /scan/entry), transfer reads, the
# last-resort item categorizer, and the chat assistant (POST /chat). Two credentials with different jobs:
#  - ANTHROPIC_API_KEY: the one-shot reads (scans, categorizer) use the Anthropic API when it is
#    set, billed per token — cheap, fast, and off the Claude plan's rate limits.
#  - CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`, requires a Claude Pro/Max plan): the chat
#    always runs on the bundled Claude Agent SDK and prefers this token, billing the owner's
#    Claude subscription. Without an API key, the one-shot reads use it too.
# Setting both is the recommended split: pennies of API billing for scans, the token-hungry chat
# on the subscription. With neither set, the Agent SDK falls back to whatever `claude` login the
# host machine has — handy in dev, not something to rely on in a deployment.
# CLAUDE_MODEL powers the one-shot reads (default claude-haiku-4-5 — cheap and accurate enough
# here); CLAUDE_CHAT_MODEL powers the chat (default claude-opus-5 — the answers are the product).
# CLAUDE_PHOTO_PROMPT is the identification instruction only (blank = built-in default); the strict
# output format is always enforced server-side.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_CHAT_MODEL=claude-opus-5
# Deciphering a receipt abbreviation the keyword rules missed is world knowledge about Brazilian
# brands, so it gets a stronger model than the extraction reads. It only runs for the lines nothing
# else could place, and it runs while the owner waits on the scan — claude-opus-5 is affordable here
# on a subscription if you would rather trade the latency for accuracy.
CLAUDE_CATEGORIZE_MODEL=claude-sonnet-5
CLAUDE_PHOTO_PROMPT=
# The typed-lançamento reader (POST /scan/entry). Blank = built-in default.
CLAUDE_ENTRY_PROMPT=
CLAUDE_CATEGORIZE_PROMPT=
CLAUDE_TIMEOUT_MS=60000
CLAUDE_CHAT_TIMEOUT_MS=180000

# Scanned items are categorized by keyword rules first, then by what the barcode was filed under
# before; both are free and always on. This gates only the model call that settles what is left —
# set false to leave those items as "other" instead.
CATEGORIZE_WITH_AI=true

# The ledger's home timezone. "ontem" and "dia 24" in a typed lançamento are resolved against today
# here, not against the container's UTC clock.
LEDGER_TIME_ZONE=America/Bahia
